root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Retained CSV bytes are evidence. Don't normalize them on save.
[*.csv]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
