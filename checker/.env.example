# Local development defaults. Set secrets through your hosting dashboard.
WEB_ORIGIN=http://localhost:5173
INSPECT_RATE_LIMIT=30
INSPECT_RATE_WINDOW_SECONDS=60
INSPECT_GLOBAL_RATE_LIMIT=3000
INSPECT_MAX_CONCURRENT=4
# Set true only after all three protected quota values are installed.
# True prevents a future deployment from silently falling back to per-process quotas.
REQUIRE_SHARED_QUOTA=false
QUOTA_REDIS_REST_URL=
QUOTA_REDIS_REST_TOKEN=
# Generate a random value of at least 32 characters. Never put it in VITE_* variables.
QUOTA_HASH_SALT=
